NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart_contract_scanner

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Backend Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Azure OpenAI (preferred - set these for AI-powered analysis)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# OpenAI API (alternative to Azure)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Ollama (local fallback - auto-used when no API keys configured)
OLLAMA_MODEL=llama3
